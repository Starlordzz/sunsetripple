        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#0E1626</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#3C5A8C</item>
        <item name="android:navigationBarColor">#0E1626</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">#3F76AC</item>
    </style>
</resources>
